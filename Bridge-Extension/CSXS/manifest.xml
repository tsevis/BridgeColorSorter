<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.bridgecolorshorter.panel"
                   ExtensionBundleVersion="0.1.1"
                   ExtensionBundleName="BridgeColorShorter"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.bridgecolorshorter.panel" Version="0.1.1" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- Adobe Bridge's CEP host code is KBRG (not BRG). Bridge 2026 = 16.x -->
      <Host Name="KBRG" Version="[11.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="5.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.bridgecolorshorter.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
          <ScriptPath>./jsx/BridgeColorShorter.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>BridgeColorShorter</Menu>
          <Geometry>
            <Size>
              <Height>560</Height>
              <Width>360</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>300</Width>
            </MinSize>
            <MaxSize>
              <Height>1400</Height>
              <Width>800</Width>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./assets/icons/icon-16.png</Icon>
            <Icon Type="RollOver">./assets/icons/icon-16-hover.png</Icon>
            <Icon Type="Disabled">./assets/icons/icon-16-disabled.png</Icon>
            <Icon Type="LargeNormal">./assets/icons/icon-32.png</Icon>
            <Icon Type="LargeRollOver">./assets/icons/icon-32-hover.png</Icon>
            <Icon Type="LargeDisabled">./assets/icons/icon-32-disabled.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
