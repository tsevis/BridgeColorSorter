{
  "name": "colorxbridge",
  "version": "2.0.0",
  "description": "Search & Sort by Color for Adobe Bridge",
  "license": "MIT",
  "private": true,
  "comment": "No dependencies by design. The panel runs inside CEP and uses only Node builtins (fs, os, path, child_process); the tests use node:test, which ships with Node.",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "build": "node scripts/build.js",
    "build:zxp": "node scripts/build.js --zxp",
    "install-panel": "node scripts/install.js",
    "uninstall": "node scripts/install.js --uninstall",
    "enable-cep": "node scripts/enable-cep.js",
    "disable-cep": "node scripts/enable-cep.js --disable",
    "status": "node scripts/install.js --status",
    "icons": "node scripts/generate-icons.js",
    "fixtures": "node scripts/make-fixtures.js",
    "compact": "node scripts/compact.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "adobe",
    "bridge",
    "cep",
    "extension",
    "color",
    "image",
    "organization",
    "xmp"
  ]
}
